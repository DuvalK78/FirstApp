function onMapClick(e) {
  if(game.current >= game.queue.length) return;
  const path = e.target.closest('path');
  if(!path) return;
  const isoClicked = path.dataset.iso;
  const [lon, lat] = svgPosToLonLat(e);
  handleAnswer(lon, lat, false, isoClicked);
}

function onMapTouch(e) {
  if(settings.mode === 'drag') return;
  e.preventDefault();
  const touch = e.changedTouches[0];
  const el = document.elementFromPoint(touch.clientX, touch.clientY);
  if(!el) return;
  const path = el.closest ? el.closest('path') : null;
  const isoClicked = path ? path.dataset.iso : null;
  const [lon, lat] = clientPosToLonLat(touch.clientX, touch.clientY);
  handleAnswer(lon, lat, false, isoClicked);
}

function svgPosToLonLat(e) {
  const svg = document.getElementById('world-map');
  const rect = svg.getBoundingClientRect();
  const xr = (e.clientX - rect.left) / rect.width;
  const yr = (e.clientY - rect.top) / rect.height;
  return [(xr * 360) - 180, 90 - (yr * 180)];
}

function clientPosToLonLat(cx, cy) {
  const svg = document.getElementById('world-map');
  const rect = svg.getBoundingClientRect();
  const xr = (cx - rect.left) / rect.width;
  const yr = (cy - rect.top) / rect.height;
  return [(xr * 360) - 180, 90 - (yr * 180)];
}

function haversine(lon1, lat1, lon2, lat2) {
  const R = 6371;
  const dLat = (lat2-lat1)*Math.PI/180;
  const dLon = (lon2-lon1)*Math.PI/180;
  const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)**2;
  return R * 2 * Math.asin(Math.sqrt(a));
}

function calcScore(distKm) {
  if(distKm < 100) return 1000;
  if(distKm < 500) return Math.round(1000 - (distKm / 500) * 300);
  if(distKm < 1500) return Math.round(700 - ((distKm-500)/1000)*300);
  if(distKm < 4000) return Math.round(400 - ((distKm-1500)/2500)*300);
  if(distKm < 8000) return Math.round(100 - ((distKm-4000)/4000)*90);
  return 10;
}

function handleAnswer(lon, lat, timeout = false, isoClicked = null) {
  if(game.current >= game.queue.length) return;
  clearInterval(game.timerInterval);

  const c = game.queue[game.current];
  const centroid = CENTROIDS[c.id] || [0, 0];

  let distKm, pts, correct;

  if(timeout) {
    distKm = 99999; pts = 0; correct = false;
  } else {
    const targetIso = getIsoForCountry(c.id);
    // Check if clicked the correct country (by ISO)
    if(isoClicked && targetIso && String(isoClicked) === String(targetIso)) {
      distKm = 0; pts = 1000; correct = true;
    } else {
      distKm = haversine(lon, lat, centroid[0], centroid[1]);
      pts = calcScore(distKm);
      correct = distKm < 300;
    }
  }

  game.score += pts;
  game.results.push({ country: c, distKm, pts, correct });

  // Color the correct country
  const targetIso = getIsoForCountry(c.id);
  if(targetIso) {
    document.querySelectorAll(`#world-map path[data-iso="${targetIso}"]`).forEach(p => {
      p.classList.remove('target');
      p.classList.add(correct ? 'correct' : (pts > 200 ? 'wrong' : 'wrong'));
      p.style.fill = '';
    });
  }

  // Feedback
  let label, color;
  if(timeout) { label = "⏰ Temps écoulé !"; color = '#e74c3c'; }
  else if(distKm < 100) { label = "🎯 Parfait !"; color = '#2ecc71'; }
  else if(distKm < 500) { label = "🔥 Excellent !"; color = '#2ecc71'; }
  else if(distKm < 1500) { label = "👍 Pas mal !"; color = '#F5C518'; }
  else if(distKm < 4000) { label = "🤔 Presque..."; color = '#e67e22'; }
  else { label = "😅 Loin !"; color = '#e74c3c'; }

  const fb = document.getElementById('feedback-overlay');
  document.getElementById('feedback-text').textContent = label;
  document.getElementById('feedback-text').style.color = color;
  document.getElementById('feedback-pts').textContent = timeout ? '' : `+${pts} pts ${distKm > 0 ? '· ' + (distKm<1000?Math.round(distKm)+'km':Math.round(distKm/100)/10+'000km') : ''}`;
  fb.classList.add('show');

  updateHUD();

  setTimeout(() => {
    fb.classList.remove('show');
    game.current++;
    if(game.current >= game.queue.length) { endGame(); }
    else {
      applyDifficultyColors();
      showCurrentCountry();
    }
  }, 1800);
}

function updateHUD() {
  document.getElementById('hud-score-val').textContent = game.score;
  const pct = game.current / game.queue.length * 100;
  document.getElementById('hud-progress').style.width = pct + '%';
  document.getElementById('hud-info').textContent = `${game.current} / ${game.queue.length}`;
}

function endGame() {
  clearInterval(game.timerInterval);
  document.getElementById('game-screen').style.display = 'none';
  document.getElementById('result-screen').style.display = 'flex';

  const max = game.queue.length * 1000;
  const pct = Math.round(game.score / max * 100);
  document.getElementById('result-score').textContent = game.score + ' pts';

  let grade;
  if(pct >= 90) grade = '🏆 Champion du monde ! Tu connais ta géographie !';
  else if(pct >= 70) grade = '⭐ Très bien ! Tu maîtrises bien la carte !';
  else if(pct >= 50) grade = '👍 Pas mal ! Encore quelques révisions ?';
  else if(pct >= 30) grade = '😅 Il faut réviser un peu !';
  else grade = '🌍 La carte du monde te résiste... mais c\'est fun !';
  document.getElementById('result-grade').textContent = grade + ` (${pct}%)`;

  // Result list
  const list = document.getElementById('result-list');
  list.innerHTML = '';
  game.results.forEach(r => {
    const cls = r.pts >= 700 ? 'good' : r.pts >= 300 ? 'ok' : 'bad';
    const dist = r.distKm > 0 ? (r.distKm < 1000 ? Math.round(r.distKm)+'km' : Math.round(r.distKm/100)/10 + '\u2009000km') : 'Parfait !';
    const name = settings.lang === 'fr' ? r.country.name_fr : r.country.name_en;
    list.innerHTML += `<div class="result-item">
      <div class="ri-dot ${cls}"></div>
      <span class="ri-flag">${r.country.flag}</span>
      <span class="ri-name">${name}</span>
      <span class="ri-dist">${r.pts===0?'Temps écoulé':dist}</span>
      <span class="ri-pts ${cls}">+${r.pts}</span>
    </div>`;
  });

  // Result map
  const rmap = document.getElementById('result-map');
  if(mapSVGData) {
    rmap.innerHTML = mapSVGData;
    game.results.forEach(r => {
      const iso = getIsoForCountry(r.country.id);
      if(!iso) return;
      rmap.querySelectorAll(`path[data-iso="${iso}"]`).forEach(p => {
        p.classList.add(r.pts >= 500 ? 'correct' : 'wrong');
      });
    });
  }
}

