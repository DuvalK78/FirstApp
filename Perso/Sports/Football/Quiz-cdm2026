<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Quiz CDM 2026 – Trouve les pays !</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --gold: #F5C518;
    --gold2: #e6a800;
    --dark: #0d0f1a;
    --darker: #07080f;
    --card: #161929;
    --card2: #1e2237;
    --green: #2ecc71;
    --red: #e74c3c;
    --blue: #3498db;
    --text: #e8eaf6;
    --muted: #7a7fa8;
    --radius: 14px;
    --transition: 0.25s ease;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; font-family: 'Nunito', sans-serif; background: var(--darker); color: var(--text); overflow-x: hidden; }

  /* ===================== MENU ===================== */
  #menu-screen {
    min-height: 100vh;
    background: radial-gradient(ellipse at 20% 20%, #1a2240 0%, var(--darker) 70%);
    display: flex; flex-direction: column; align-items: center; justify-content: flex-start;
    padding: 20px 16px 40px;
    overflow-y: auto;
  }
  .menu-logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.4rem, 8vw, 4rem);
    color: var(--gold);
    letter-spacing: 3px;
    text-align: center;
    line-height: 1;
    margin-bottom: 4px;
    text-shadow: 0 0 30px rgba(245,197,24,0.4);
  }
  .menu-sub {
    font-size: 0.85rem; color: var(--muted); margin-bottom: 28px; text-align: center; letter-spacing: 1px;
  }
  .ball-icon { font-size: 2.2rem; margin-bottom: 8px; }

  .settings-card {
    background: var(--card);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: var(--radius);
    padding: 20px;
    width: 100%; max-width: 420px;
    margin-bottom: 14px;
  }
  .settings-card h3 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.1rem; letter-spacing: 2px;
    color: var(--gold); margin-bottom: 14px;
  }
  .option-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
  }
  .option-grid.cols3 { grid-template-columns: 1fr 1fr 1fr; }
  .option-btn {
    background: var(--card2); border: 2px solid rgba(255,255,255,0.08);
    border-radius: 10px; padding: 10px 6px;
    color: var(--text); font-family: 'Nunito', sans-serif;
    font-size: 0.82rem; font-weight: 700;
    cursor: pointer; transition: var(--transition);
    text-align: center; line-height: 1.3;
  }
  .option-btn:hover { border-color: var(--gold); color: var(--gold); }
  .option-btn.selected { background: rgba(245,197,24,0.15); border-color: var(--gold); color: var(--gold); }
  .option-btn .opt-icon { font-size: 1.3rem; display: block; margin-bottom: 4px; }
  .option-btn .opt-desc { font-size: 0.7rem; color: var(--muted); font-weight: 600; margin-top: 2px; display: block; }

  .info-box {
    background: rgba(245,197,24,0.06); border-left: 3px solid var(--gold);
    border-radius: 0 8px 8px 0; padding: 10px 12px;
    font-size: 0.78rem; color: var(--muted); line-height: 1.5;
    margin-top: 10px;
  }
  .info-box strong { color: var(--text); }

  .start-btn {
    width: 100%; max-width: 420px;
    background: linear-gradient(135deg, var(--gold), var(--gold2));
    color: var(--darker); font-family: 'Bebas Neue', sans-serif;
    font-size: 1.4rem; letter-spacing: 3px;
    border: none; border-radius: var(--radius);
    padding: 16px; cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s;
    box-shadow: 0 4px 20px rgba(245,197,24,0.3);
    margin-top: 6px;
  }
  .start-btn:active { transform: scale(0.97); }
  .start-btn:hover { box-shadow: 0 6px 30px rgba(245,197,24,0.5); }

  /* ===================== GAME SCREEN ===================== */
  #game-screen {
    display: none; flex-direction: column; height: 100vh; overflow: hidden;
  }
  .game-header {
    background: var(--card); border-bottom: 1px solid rgba(255,255,255,0.06);
    padding: 10px 14px; display: flex; align-items: center; gap: 10px;
    flex-shrink: 0; position: relative;
  }
  .hud-score {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.6rem; color: var(--gold);
    line-height: 1; min-width: 55px;
  }
  .hud-score span { font-size: 0.7rem; color: var(--muted); display: block; font-family: 'Nunito', sans-serif; font-weight: 700; letter-spacing: 1px; }
  .hud-progress-wrap { flex: 1; }
  .hud-progress-bar {
    height: 6px; background: rgba(255,255,255,0.1); border-radius: 3px; overflow: hidden;
  }
  .hud-progress-fill {
    height: 100%; background: var(--gold); border-radius: 3px;
    transition: width 0.4s ease; width: 0%;
  }
  .hud-info { font-size: 0.72rem; color: var(--muted); margin-top: 3px; text-align: right; }
  .hud-timer {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.4rem;
    min-width: 38px; text-align: center;
  }
  .hud-timer.urgent { color: var(--red); animation: pulse 0.5s infinite alternate; }
  @keyframes pulse { from { opacity:1 } to { opacity:0.4 } }

  .country-panel {
    background: var(--dark); padding: 10px 14px 8px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    flex-shrink: 0; text-align: center;
  }
  .country-label { font-size: 0.7rem; color: var(--muted); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 4px; }
  .country-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(1.5rem, 6vw, 2.2rem);
    color: var(--text); letter-spacing: 2px;
    line-height: 1;
  }
  .country-flag { font-size: 1.8rem; }
  .country-hint { font-size: 0.75rem; color: var(--muted); margin-top: 3px; }

  /* MAP */
  #map-container {
    flex: 1; position: relative; overflow: hidden;
    background: #0c1420;
    touch-action: none;
  }
  #world-map {
    width: 100%; height: 100%;
    cursor: crosshair;
    display: block;
  }
  #world-map path {
    fill: #1e2d45; stroke: #0c1420; stroke-width: 0.5;
    transition: fill 0.15s;
  }
  #world-map path:hover { fill: #2a4a6b; }
  #world-map path.qualified { fill: rgba(245,197,24,0.25); stroke: var(--gold); stroke-width: 1; }
  #world-map path.correct { fill: rgba(46,204,113,0.45); stroke: var(--green); stroke-width: 1.5; }
  #world-map path.wrong { fill: rgba(231,76,60,0.35); stroke: var(--red); stroke-width: 1; }
  #world-map path.target { fill: rgba(52,152,219,0.5); stroke: var(--blue); stroke-width: 2; }
  #world-map path.disabled { pointer-events: none; }

  /* Drag mode: floating card */
  #drag-card {
    display: none; position: fixed; z-index: 200;
    background: var(--gold); color: var(--darker);
    border-radius: 10px; padding: 6px 14px;
    font-family: 'Bebas Neue', sans-serif; font-size: 1.1rem;
    pointer-events: none; white-space: nowrap;
    box-shadow: 0 4px 20px rgba(0,0,0,0.5);
    transform: translate(-50%, -50%);
  }

  /* Feedback overlay */
  #feedback-overlay {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
    z-index: 100; text-align: center; pointer-events: none;
    opacity: 0; transition: opacity 0.2s;
  }
  #feedback-overlay.show { opacity: 1; }
  .feedback-text {
    font-family: 'Bebas Neue', sans-serif; font-size: clamp(1.8rem, 8vw, 3rem);
    letter-spacing: 2px; text-shadow: 0 2px 10px rgba(0,0,0,0.8);
  }
  .feedback-pts {
    font-family: 'Bebas Neue', sans-serif; font-size: clamp(1.1rem, 4vw, 1.6rem);
    color: var(--gold); text-shadow: 0 2px 10px rgba(0,0,0,0.8);
  }

  /* Distance indicator */
  #distance-bar {
    position: absolute; bottom: 0; left: 0; right: 0;
    height: 5px; background: transparent; z-index: 50;
    transition: background 0.3s;
  }

  /* ===================== RESULT SCREEN ===================== */
  #result-screen {
    display: none; min-height: 100vh; overflow-y: auto;
    background: radial-gradient(ellipse at 50% 0%, #1a2240 0%, var(--darker) 60%);
    padding: 24px 16px 40px; align-items: center; flex-direction: column;
  }
  .result-title {
    font-family: 'Bebas Neue', sans-serif; font-size: clamp(2rem, 8vw, 3rem);
    color: var(--gold); letter-spacing: 3px; text-align: center; margin-bottom: 4px;
  }
  .result-score-big {
    font-family: 'Bebas Neue', sans-serif; font-size: clamp(3rem, 15vw, 5rem);
    color: var(--text); letter-spacing: 2px; text-align: center; line-height: 1;
  }
  .result-grade {
    font-size: 0.9rem; color: var(--muted); text-align: center; margin-bottom: 20px;
  }
  #result-map-wrap {
    width: 100%; max-width: 500px; margin: 0 auto 20px;
    border-radius: 12px; overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
  }
  #result-map { width: 100%; display: block; }
  #result-map path { fill: #1e2d45; stroke: #0c1420; stroke-width: 0.5; }
  #result-map path.correct { fill: rgba(46,204,113,0.55); stroke: var(--green); stroke-width: 1.5; }
  #result-map path.wrong { fill: rgba(231,76,60,0.4); stroke: var(--red); stroke-width: 1; }
  #result-map path.missed { fill: rgba(245,197,24,0.2); stroke: var(--gold); stroke-width: 1; }

  .result-list {
    width: 100%; max-width: 500px; margin: 0 auto 20px;
    display: flex; flex-direction: column; gap: 6px;
  }
  .result-item {
    background: var(--card); border-radius: 10px;
    padding: 10px 14px; display: flex; align-items: center; gap: 10px;
    font-size: 0.82rem;
  }
  .result-item .ri-flag { font-size: 1.2rem; }
  .result-item .ri-name { flex: 1; font-weight: 700; }
  .result-item .ri-pts { font-family: 'Bebas Neue', sans-serif; font-size: 1.1rem; min-width: 40px; text-align: right; }
  .result-item .ri-pts.good { color: var(--green); }
  .result-item .ri-pts.ok { color: var(--gold); }
  .result-item .ri-pts.bad { color: var(--red); }
  .result-item .ri-dist { font-size: 0.7rem; color: var(--muted); min-width: 60px; text-align: right; }
  .ri-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .ri-dot.good { background: var(--green); }
  .ri-dot.ok { background: var(--gold); }
  .ri-dot.bad { background: var(--red); }

  .result-actions { display: flex; gap: 10px; width: 100%; max-width: 500px; margin: 0 auto; }
  .result-btn {
    flex: 1; padding: 14px; border-radius: var(--radius);
    font-family: 'Bebas Neue', sans-serif; font-size: 1.1rem; letter-spacing: 2px;
    cursor: pointer; border: none; transition: var(--transition);
  }
  .result-btn.primary { background: var(--gold); color: var(--darker); }
  .result-btn.secondary { background: var(--card2); color: var(--text); border: 1px solid rgba(255,255,255,0.1); }

  /* ===================== DRAG PANEL ===================== */
  #drag-panel {
    display: none; background: var(--card);
    border-top: 1px solid rgba(255,255,255,0.08);
    padding: 10px 14px; text-align: center;
    flex-shrink: 0;
  }
  .drag-pill {
    display: inline-block;
    background: var(--gold); color: var(--darker);
    font-family: 'Bebas Neue', sans-serif; font-size: 1.3rem;
    letter-spacing: 2px; padding: 8px 24px; border-radius: 30px;
    cursor: grab; user-select: none;
    box-shadow: 0 3px 12px rgba(245,197,24,0.4);
    touch-action: none;
  }
  .drag-hint { font-size: 0.72rem; color: var(--muted); margin-top: 5px; }

  /* scroll fix */
  .scrollable { overflow-y: auto; }

  .legend-row { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin: 10px 0 0; }
  .legend-item { display: flex; align-items: center; gap: 5px; font-size: 0.7rem; color: var(--muted); }
  .legend-dot { width: 10px; height: 10px; border-radius: 2px; flex-shrink: 0; }
</style>
</head>
<body>

<!-- ===================== MENU ===================== -->
<div id="menu-screen">
  <div class="ball-icon">⚽</div>
  <div class="menu-logo">Quiz CDM 2026</div>
  <div class="menu-sub">Place les pays qualifiés sur la carte !</div>

  <div class="settings-card">
    <h3>🌍 Nombre de pays</h3>
    <div class="option-grid cols3" id="opt-count">
      <button class="option-btn" data-val="6">
        <span class="opt-icon">🟢</span>6 pays
        <span class="opt-desc">Super rapide</span>
      </button>
      <button class="option-btn selected" data-val="12">
        <span class="opt-icon">🟡</span>12 pays
        <span class="opt-desc">Court</span>
      </button>
      <button class="option-btn" data-val="24">
        <span class="opt-icon">🟠</span>24 pays
        <span class="opt-desc">Normal</span>
      </button>
    </div>
    <div style="margin-top:8px">
      <button class="option-btn" data-val="48" style="width:100%; grid-column: span 3; display:block; margin:0">
        <span class="opt-icon" style="display:inline">🔴</span> 48 pays — Tous les qualifiés !
        <span class="opt-desc">Mode champion</span>
      </button>
    </div>
  </div>

  <div class="settings-card">
    <h3>🎮 Mode de jeu</h3>
    <div class="option-grid" id="opt-mode">
      <button class="option-btn selected" data-val="click">
        <span class="opt-icon">👆</span>Clic
        <span class="opt-desc">Tape sur la carte</span>
      </button>
      <button class="option-btn" data-val="drag">
        <span class="opt-icon">✋</span>Glisser
        <span class="opt-desc">Glisse le pays</span>
      </button>
    </div>
  </div>

  <div class="settings-card">
    <h3>📊 Difficulté</h3>
    <div class="option-grid cols3" id="opt-diff">
      <button class="option-btn selected" data-val="easy">
        <span class="opt-icon">😊</span>Facile
        <span class="opt-desc">Continents colorés + indices</span>
      </button>
      <button class="option-btn" data-val="medium">
        <span class="opt-icon">😐</span>Normal
        <span class="opt-desc">Carte sans couleurs</span>
      </button>
      <button class="option-btn" data-val="hard">
        <span class="opt-icon">😤</span>Difficile
        <span class="opt-desc">Aucun indice</span>
      </button>
    </div>
    <div id="diff-info" class="info-box" style="margin-top:10px">
      <strong>😊 Facile :</strong> Les continents sont colorés, le pays est entouré en bleu sur la carte, et un indice de continent est affiché.
    </div>
  </div>

  <div class="settings-card">
    <h3>⏱️ Chronomètre</h3>
    <div class="option-grid cols3" id="opt-timer">
      <button class="option-btn selected" data-val="none">
        <span class="opt-icon">🧘</span>Zen
        <span class="opt-desc">Pas de timer</span>
      </button>
      <button class="option-btn" data-val="pergame">
        <span class="opt-icon">⏳</span>Par pays
        <span class="opt-desc">30s par pays</span>
      </button>
      <button class="option-btn" data-val="global">
        <span class="opt-icon">⏱️</span>Global
        <span class="opt-desc">5min total</span>
      </button>
    </div>
  </div>

  <div class="settings-card">
    <h3>🌐 Langue des pays</h3>
    <div class="option-grid" id="opt-lang">
      <button class="option-btn selected" data-val="fr">
        <span class="opt-icon">🇫🇷</span>Français
      </button>
      <button class="option-btn" data-val="en">
        <span class="opt-icon">🇬🇧</span>Anglais
      </button>
    </div>
  </div>

  <button class="start-btn" id="start-btn">⚽ JOUER !</button>
</div>

<!-- ===================== GAME SCREEN ===================== -->
<div id="game-screen">
  <div class="game-header">
    <div class="hud-score">
      <span>SCORE</span>
      <span id="hud-score-val">0</span>
    </div>
    <div class="hud-progress-wrap">
      <div class="hud-progress-bar"><div class="hud-progress-fill" id="hud-progress"></div></div>
      <div class="hud-info" id="hud-info">0 / 0</div>
    </div>
    <div class="hud-timer" id="hud-timer" style="display:none">--</div>
  </div>

  <div class="country-panel">
    <div class="country-label">Où se trouve ce pays ?</div>
    <div style="display:flex;align-items:center;justify-content:center;gap:10px">
      <span class="country-flag" id="country-flag"></span>
      <span class="country-name" id="country-name">…</span>
    </div>
    <div class="country-hint" id="country-hint"></div>
  </div>

  <div id="map-container">
    <svg id="world-map" viewBox="0 0 1000 500" xmlns="http://www.w3.org/2000/svg"></svg>
    <div id="feedback-overlay">
      <div class="feedback-text" id="feedback-text"></div>
      <div class="feedback-pts" id="feedback-pts"></div>
    </div>
    <div id="distance-bar"></div>
  </div>

  <div id="drag-panel">
    <div class="drag-pill" id="drag-pill">France 🇫🇷</div>
    <div class="drag-hint">Glisse ce pays sur la carte ⬆️</div>
  </div>

  <div id="drag-card"></div>
</div>

<!-- ===================== RESULT SCREEN ===================== -->
<div id="result-screen">
  <div class="result-title">🏆 Résultats</div>
  <div class="result-score-big" id="result-score">0</div>
  <div class="result-grade" id="result-grade"></div>

  <div id="result-map-wrap">
    <svg id="result-map" viewBox="0 0 1000 500" xmlns="http://www.w3.org/2000/svg"></svg>
  </div>
  <div class="legend-row">
    <div class="legend-item"><div class="legend-dot" style="background:var(--green)"></div> Parfait / Proche</div>
    <div class="legend-item"><div class="legend-dot" style="background:var(--gold)"></div> Assez proche</div>
    <div class="legend-item"><div class="legend-dot" style="background:var(--red)"></div> Loin</div>
  </div>
  <br>
  <div class="result-list" id="result-list"></div>
  <div class="result-actions">
    <button class="result-btn secondary" id="btn-menu">Menu</button>
    <button class="result-btn primary" id="btn-retry">Rejouer</button>
  </div>
</div>

