let dragEl = null;

function setupDrag(pill) {
  pill.addEventListener('touchstart', dragStart, {passive: false});
  pill.addEventListener('mousedown', dragStart);
}

function dragStart(e) {
  e.preventDefault();
  dragging = true;
  const card = document.getElementById('drag-card');
  card.textContent = document.getElementById('drag-pill').textContent;
  card.style.display = 'block';
  moveDragCard(e);
  document.addEventListener('touchmove', dragMove, {passive: false});
  document.addEventListener('mousemove', dragMove);
  document.addEventListener('touchend', dragEnd);
  document.addEventListener('mouseup', dragEnd);
}

function moveDragCard(e) {
  const card = document.getElementById('drag-card');
  const touch = e.touches ? e.touches[0] : e;
  card.style.left = touch.clientX + 'px';
  card.style.top = touch.clientY + 'px';
}

function dragMove(e) {
  if(!dragging) return;
  e.preventDefault();
  moveDragCard(e);
}

function dragEnd(e) {
  if(!dragging) return;
  dragging = false;
  document.getElementById('drag-card').style.display = 'none';
  document.removeEventListener('touchmove', dragMove);
  document.removeEventListener('mousemove', dragMove);
  document.removeEventListener('touchend', dragEnd);
  document.removeEventListener('mouseup', dragEnd);

  const touch = e.changedTouches ? e.changedTouches[0] : e;
  const el = document.elementFromPoint(touch.clientX, touch.clientY);
  if(!el) return;
  const path = el.closest ? el.closest('path') : null;
  const mapContainer = document.getElementById('map-container');
  const mapRect = mapContainer.getBoundingClientRect();
  if(touch.clientX < mapRect.left || touch.clientX > mapRect.right ||
     touch.clientY < mapRect.top || touch.clientY > mapRect.bottom) return;

  const isoClicked = path ? path.dataset.iso : null;
  const [lon, lat] = clientPosToLonLat(touch.clientX, touch.clientY);
  handleAnswer(lon, lat, false, isoClicked);
}

