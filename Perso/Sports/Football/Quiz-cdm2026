async function loadMap() {
  if(mapSVGLoaded) return;
  try {
    const resp = await fetch('https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json');
    const topo = await resp.json();
    drawMapFromTopo(topo);
    mapSVGLoaded = true;
  } catch(e) {
    // fallback: simplified placeholder
    drawFallbackMap();
  }
}

function drawMapFromTopo(topo) {
  // Use simple equirectangular projection
  const svg = document.getElementById('world-map');
  const rsvg = document.getElementById('result-map');
  const W = 1000, H = 500;

  function project(lon, lat) {
    const x = (lon + 180) * (W / 360);
    const y = (90 - lat) * (H / 180);
    return [x, y];
  }

  function arcToPath(arcs, arcIndex) {
    const pts = [];
    let i = arcIndex < 0 ? ~arcIndex : arcIndex;
    const arc = topo.arcs[i];
    let x=0, y=0;
    for(const [dx, dy] of arc) { x+=dx; y+=dy; pts.push([x,y]); }
    if(arcIndex < 0) pts.reverse();
    return pts;
  }

  function topoArcToSVG(rings) {
    let d = '';
    for(const ring of rings) {
      let first = true;
      let pts = [];
      for(const arcIdx of ring) {
        const ap = arcToPath(topo.arcs, arcIdx);
        if(!first) ap.shift();
        pts = pts.concat(ap);
        first = false;
      }
      const scale = topo.transform.scale;
      const translate = topo.transform.translate;
      pts.forEach((p, j) => {
        const lon = p[0] * scale[0] + translate[0];
        const lat = p[1] * scale[1] + translate[1];
        const [sx, sy] = project(lon, lat);
        d += (j===0 ? 'M' : 'L') + sx.toFixed(1) + ',' + sy.toFixed(1);
      });
      d += 'Z';
    }
    return d;
  }

  const countries = topo.objects.countries.geometries;
  let htmlGame = '', htmlResult = '';

  // Continent mapping (rough by ISO numeric)
  function isoToContinent(iso) {
    const n = parseInt(iso);
    if([124,840,484,304,840].includes(n)) return "North America";
    if(n>=32 && n<=858 && [32,68,76,152,170,218,600,604,858,862,604,328].includes(n)) return "South America";
    if(n>=4 && n<=860 && n!==36 && n!==554) {
      if([4,50,64,144,356,364,368,392,400,408,410,418,422,458,462,496,524,586,634,682,702,704,760,764,792,800,860,887].includes(n)) return "Asia";
    }
    if([12,24,72,108,120,132,140,144,174,180,204,226,231,232,262,266,270,288,312,324,384,404,426,430,434,450,454,466,478,480,504,508,516,562,566,586,646,686,694,706,710,716,724,728,729,768,788,800,818,834,854,894].includes(n)) return "Africa";
    if([36,90,242,598,882,548].includes(n)) return "Oceania";
    return "Europe";
  }

  const CONT_EASY_FILL = {
    "Europe": "#1a3562","Asia": "#1e3d3d","Africa": "#3d2c16",
    "North America": "#1d3620","South America": "#2d1e40","Oceania": "#1a2e40"
  };

  countries.forEach(geo => {
    const isoNum = geo.id;
    let d = '';
    if(geo.type === 'Polygon') d = topoArcToSVG(geo.arcs);
    else if(geo.type === 'MultiPolygon') geo.arcs.forEach(r => { d += topoArcToSVG(r); });
    if(!d) return;
    const cont = isoToContinent(isoNum);
    htmlGame += `<path d="${d}" data-iso="${isoNum}" data-cont="${cont}"/>`;
    htmlResult += `<path d="${d}" data-iso="${isoNum}" data-cont="${cont}"/>`;
  });

  svg.innerHTML = htmlGame;
  rsvg.innerHTML = htmlResult;
  mapSVGData = htmlGame;
  resultMapSVGData = htmlResult;

  // Click handler
  svg.addEventListener('click', onMapClick);
  svg.addEventListener('touchend', onMapTouch, {passive: false});
}

